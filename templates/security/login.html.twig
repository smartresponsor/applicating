{% extends '@Interfacing/base.html.twig' %}

{% block title %}Applicating Login{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3">Application Workspace Login</h1>
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label" for="username">Username</label>
                            <input class="form-control" id="username" name="_username" value="{{ last_username }}" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="password">Password</label>
                            <input class="form-control" id="password" name="_password" type="password" required>
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <button class="btn btn-primary w-100" type="submit">Sign in</button>
                    </form>
                    <div class="small text-muted mt-3">
                        Demo users: <code>admin/admin</code>, <code>manager/manager</code>, <code>viewer/viewer</code>.
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
