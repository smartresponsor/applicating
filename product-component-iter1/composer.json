  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "doctrine/orm": "^2.18",
    "symfony/uid": "^7.0",
    "psr/event-dispatcher": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Component\\Product\\": "src/Product/"
    }
  },
