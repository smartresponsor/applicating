{% extends 'base.html.twig' %}

{% block title %}New Application{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3">Create application</h1>
                    {{ form_start(form) }}
                        {{ form_widget(form) }}
                        <button class="btn btn-primary mt-3" type="submit">Create</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
