{
  "name": "smartresponsor/product-component",
  "description": "Product domain component v3 (outbox, migrations, Redis config, factory/mapper) for Smartresponsor / iSponsor.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "doctrine/orm": "^2.18",
    "symfony/uid": "^7.0",
    "psr/event-dispatcher": "^1.0",
    "psr/cache": "^3.0",
    "symfony/console": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Component\\Product\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}