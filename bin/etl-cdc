#!/usr/bin/env php
<?php
declare(strict_types=1);
require __DIR__.'/../vendor/autoload.php';

use Doctrine\DBAL\DriverManager;
use App\Component\Product\ETL\Job\CDCReplicator;

$db = DriverManager::getConnection(['url'=>getenv('DATABASE_URL') ?: 'pdo-sqlite:///:memory:']);
$cdc = new CDCReplicator($db);
$replicated = $cdc->replicate();
echo json_encode(['replicated'=>$replicated], JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE), PHP_EOL;
