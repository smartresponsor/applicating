#!/usr/bin/env php
<?php
declare(strict_types=1);
require __DIR__.'/../vendor/autoload.php';

use Doctrine\DBAL\DriverManager;
use App\Component\Product\Security\Consent\ConsentRegistry;

$tenant = $argv[1] ?? 'tenantA';
$subject = $argv[2] ?? 'user-1';
$purpose = $argv[3] ?? 'marketing';
$granted = ($argv[4] ?? 'true') === 'true';

$db = DriverManager::getConnection(['url'=>getenv('DATABASE_URL') ?: 'pdo-sqlite:///:memory:']);
$cr = new ConsentRegistry($db);
$cr->set($tenant,$subject,$purpose,$granted);
echo json_encode(['ok'=>true,'tenant'=>$tenant,'subject'=>$subject,'purpose'=>$purpose,'granted'=>$granted], JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE), PHP_EOL;
