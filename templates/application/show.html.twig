{% extends 'base.html.twig' %}

{% block title %}{{ application.name }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">{{ application.name }}</h1>
            <div class="text-muted">{{ application.packageName }} · {{ application.slug }}</div>
            <p class="mt-3 mb-0">{{ application.listingSummary }}</p>
        </div>
        <div class="d-flex gap-2">
            {% if is_granted('APPLICATION_PUBLISH', application) and application.publicationState.value == 'published' %}
                <form method="post" action="{{ path('applicating_application_suspend', {id: application.id}) }}">
                    <button class="btn btn-outline-warning" type="submit">Suspend</button>
                </form>
            {% endif %}
            {% if is_granted('APPLICATION_EDIT', application) %}
                <a class="btn btn-outline-primary" href="{{ path('applicating_application_edit', {id: application.id}) }}">Edit</a>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ path('applicating_application_index') }}">Back</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Releases</h2>
                    <ul class="list-group mb-3">
                        {% for release in application.releases %}
                            {% set publishState = publishEligibility[release.id] ?? {'eligible': false, 'reason': 'Publish eligibility unavailable.'} %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">{{ release.version }} <span class="badge bg-light text-dark">{{ release.channel }}</span></div>
                                    <div class="small text-muted">{{ release.downloadUrl }}</div>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted">{{ release.publicationState.value }}</div>
                                    {% if is_granted('APPLICATION_PUBLISH', application) and release.publicationState.value != 'published' %}
                                        {% if publishState.eligible %}
                                            <form method="post" action="{{ path('applicating_application_publish', {id: application.id, releaseId: release.id}) }}">
                                                <button class="btn btn-sm btn-success mt-2">Publish</button>
                                            </form>
                                        {% else %}
                                            <div class="small text-danger mt-2">{{ publishState.reason }}</div>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">No releases yet.</li>
                        {% endfor %}
                    </ul>
                    {% if is_granted('APPLICATION_EDIT', application) %}
                        {{ form_start(releaseForm) }}
                            <h3 class="h6">Create release</h3>
                            {{ form_widget(releaseForm) }}
                            <button class="btn btn-primary mt-3" type="submit">Add release</button>
                        {{ form_end(releaseForm) }}
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5">Manifests</h2>
                    <ul class="list-group mb-3">
                        {% for manifest in application.manifests %}
                            <li class="list-group-item">
                                <div class="fw-semibold">{{ manifest.identifier }}</div>
                                <div class="small text-muted">Manifest {{ manifest.manifestVersion }} · sandbox {{ manifest.sandboxProfile }} · governance {{ manifest.governanceState }}</div>
                                <div class="small mt-2">Capabilities: {{ manifest.capabilities|join(', ') ?: 'none' }}</div>
                                <div class="small">Runtime hooks: {{ manifest.runtimeHooks|join(', ') ?: 'none' }}</div>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">No manifests yet.</li>
                        {% endfor %}
                    </ul>
                    {% if is_granted('APPLICATION_EDIT', application) %}
                        {{ form_start(manifestForm) }}
                            <h3 class="h6">Attach manifest</h3>
                            {{ form_widget(manifestForm) }}
                            <button class="btn btn-primary mt-3" type="submit">Add manifest</button>
                        {{ form_end(manifestForm) }}
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Tenant assignments</h2>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Installed version</th>
                                <th>State</th>
                                <th>Billing</th>
                                <th>Diagnostics</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for tenantApplication in application.tenantApplications %}
                                <tr>
                                    <td>{{ tenantApplication.tenantKey }}</td>
                                    <td>{{ tenantApplication.installedVersion }}</td>
                                    <td>{{ tenantApplication.installationState.value }}</td>
                                    <td>{{ tenantApplication.billingActive ? 'active' : 'inactive' }}</td>
                                    <td><pre class="small mb-0">{{ tenantApplication.diagnostics|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></td>
                                    <td class="text-end">
                                        {% if is_granted('APPLICATION_TOGGLE', tenantApplication) %}
                                            <form method="post" action="{{ path('applicating_tenant_application_toggle', {id: tenantApplication.id}) }}">
                                                <input type="hidden" name="enabled" value="{{ tenantApplication.enabled ? '0' : '1' }}">
                                                <button class="btn btn-sm {{ tenantApplication.enabled ? 'btn-outline-warning' : 'btn-outline-success' }}">
                                                    {{ tenantApplication.enabled ? 'Disable' : 'Enable' }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center text-muted">No tenant assignments yet.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% if is_granted('APPLICATION_ASSIGN', application) %}
                        <div class="border-top pt-4 mt-4">
                            {{ form_start(assignmentForm) }}
                                <h3 class="h6">Assign to tenant</h3>
                                {{ form_widget(assignmentForm) }}
                                <button class="btn btn-primary mt-3" type="submit">Assign application</button>
                            {{ form_end(assignmentForm) }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
