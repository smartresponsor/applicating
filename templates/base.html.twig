<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Applicating{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('applicating_application_index') }}">Applicating</a>
        <div class="navbar-nav me-auto">
            <a class="nav-link" href="{{ path('applicating_application_index') }}">Applications</a>
            <a class="nav-link" href="{{ path('applicating_application_report') }}">Reports</a>
        </div>
        <div class="navbar-nav">
            {% if app.user %}
                <span class="navbar-text text-white me-3">{{ app.user.userIdentifier }}</span>
                <a class="nav-link" href="{{ path('applicating_security_logout') }}">Logout</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container pb-5">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'success' ? 'success' : 'info') }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>
</body>
</html>
