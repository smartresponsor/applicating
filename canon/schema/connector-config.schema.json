{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorConfig",
  "type": "object",
  "required": [
    "type",
    "endpoint"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pim",
        "erp",
        "search"
      ]
    },
    "endpoint": {
      "type": "string"
    },
    "auth": {
      "type": "object"
    }
  }
}