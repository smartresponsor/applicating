#!/usr/bin/env php
<?php
declare(strict_types=1);
require __DIR__.'/../vendor/autoload.php';

use Doctrine\DBAL\DriverManager;

$db = DriverManager::getConnection(['url'=>getenv('DATABASE_URL') ?: 'pdo-sqlite:///:memory:']);
$rows = $db->fetchAllAssociative('SELECT * FROM audit_logs ORDER BY ts DESC LIMIT 50');
echo json_encode($rows, JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE), PHP_EOL;
