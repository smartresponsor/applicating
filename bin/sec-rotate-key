#!/usr/bin/env php
<?php
declare(strict_types=1);
require __DIR__.'/../vendor/autoload.php';

use Doctrine\DBAL\DriverManager;
use App\Component\Product\Security\Secrets\KeyRotation;

$key = $argv[1] ?? 'api/partner';
$db = DriverManager::getConnection(['url'=>getenv('DATABASE_URL') ?: 'pdo-sqlite:///:memory:']);
$kr = new KeyRotation($db);
$ok = $kr->rotate($key);
echo json_encode(['rotated'=>$ok,'key'=>$key], JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE), PHP_EOL;
