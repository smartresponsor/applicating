#!/usr/bin/env php
<?php
declare(strict_types=1);
require __DIR__.'/../vendor/autoload.php';
use Doctrine\DBAL\DriverManager;
use App\Component\Product\Billing\WalletService;

$tenant = $argv[1] ?? 'tenantA';
$amount = (float)($argv[2] ?? 25.0);
$source = $argv[3] ?? 'manual';

$db = DriverManager::getConnection(['url'=>getenv('DATABASE_URL') ?: 'pdo-sqlite:///:memory:']);
$ws = new WalletService($db);
$ws->topup($tenant, $amount, $source);
$bal = $ws->getBalance($tenant);
echo json_encode(['ok'=>true,'balance_usd'=>$bal], JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE), PHP_EOL;
