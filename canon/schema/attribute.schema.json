{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attribute",
  "type": "object",
  "required": [
    "code",
    "type"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "int",
        "decimal",
        "bool",
        "date",
        "enum"
      ]
    },
    "value": {}
  }
}