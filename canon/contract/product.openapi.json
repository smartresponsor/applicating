{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartResponsor Product API",
    "version": "1.0.0"
  },
  "paths": {
    "/product": {
      "get": {
        "summary": "List product",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create product",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/product/{id}": {
      "get": {
        "summary": "Get product by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "summary": "Patch product",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/variant": {
      "post": {
        "summary": "Create variant",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/variant/{sku}": {
      "patch": {
        "summary": "Patch variant",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "$ref": "../schema/product.schema.json"
      },
      "Variant": {
        "$ref": "../schema/variant.schema.json"
      }
    }
  }
}