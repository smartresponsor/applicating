  "title": "Canary vs Stable",
  "panels": [
    {
      "type": "graph",
      "title": "RPS (canary vs stable)",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"catalog-canary\"}[1m]))"
