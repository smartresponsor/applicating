{
  "info": {
    "name": "Smartresponsor Catalog API",
    "_postman_id": "b3d2ad2a-0000-4a00-9000-000000000001",
    "description": "Коллекция для тестирования Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/catalog?limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalog"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Show item",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/catalog/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalog",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Facets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/catalog/facets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalog",
            "facets"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost"
    }
  ]
}