#!/usr/bin/env php
<?php
require __DIR__.'/../vendor/autoload.php';
use App\Component\Product\AI\SelfHealing\Clients\KubernetesClient;
$dep = $argv[1] ?? 'app';
$on = ($argv[2] ?? 'on') === 'on';
$k8s = new KubernetesClient(getenv('K8S_NAMESPACE') ?: 'default');
if($on){
  [$code,$out,$err] = $k8s->kubectl(['label','deployment',$dep,'traffic=blocked','--overwrite=true']);
} else {
  [$code,$out,$err] = $k8s->kubectl(['label','deployment',$dep,'traffic-']);
}
echo $out ?: $err, PHP_EOL;
exit($code);
