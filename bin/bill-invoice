#!/usr/bin/env php
<?php
declare(strict_types=1);
require __DIR__.'/../vendor/autoload.php';
use Doctrine\DBAL\DriverManager;
use App\Component\Product\Billing\InvoiceGenerator;

$tenant = $argv[1] ?? 'tenantA';
$period = $argv[2] ?? gmdate('Y-m');

$db = DriverManager::getConnection(['url'=>getenv('DATABASE_URL') ?: 'pdo-sqlite:///:memory:']);
$ig = new InvoiceGenerator($db);
$id = $ig->generate($tenant, $period);
echo json_encode(['ok'=>true,'invoice_id'=>$id], JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE), PHP_EOL;
